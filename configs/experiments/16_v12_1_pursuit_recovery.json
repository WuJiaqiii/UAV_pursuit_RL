    {
      "name": "R1: Static",
      "task": "static",
      "seeds": [
        42
      ],
      "physics_steps": 8000000
    },
    {
      "name": "R2: Low Tail",
      "task": "tail",
      "seeds": [
        42
      ],
      "physics_steps": 8000000
    }
  ],
  "evaluation": {
    "profiles": [
      "near_static",
      "static",
      "tail",
      "head_on",
      "random"
    ],
